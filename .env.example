EXPO_PUBLIC_SPOTIFY_CLIENT_ID=spotify_client_id
EXPO_PUBLIC_DEEZER_APP_ID=deezer_app_id

# URL du serveur de lobby (dossier /server). Sur un appareil physique,
# remplace "localhost" par l'IP locale de la machine qui héberge le serveur,
# par exemple http://192.168.1.23:4000
EXPO_PUBLIC_LOBBY_SERVER_URL=http://localhost:4000