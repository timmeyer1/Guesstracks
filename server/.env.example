# MongoDB (visible dans MongoDB Compass en te connectant à la même URI)
MONGODB_URI=mongodb://127.0.0.1:27017/guesstracks

# Port d'écoute du serveur de lobby
PORT=4000

# Origines autorisées pour le CORS (séparées par des virgules, ex:
# https://guesstracks.app,guesstracks://). "*" accepté en dev uniquement :
# le serveur refuse de démarrer sans cette variable quand NODE_ENV=production.
CORS_ORIGIN=*

# App Deezer (https://developers.deezer.com/myapps) — le secret ne doit
# jamais être exposé côté client, d'où l'échange de code fait ici
DEEZER_APP_ID=deezer_app_id
DEEZER_APP_SECRET=deezer_app_secret

# Secret de signature des jetons de session de lobby (JWT liant chaque
# requête/socket à une identité de joueur vérifiée). Génère une valeur unique
# en local avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
LOBBY_JWT_SECRET=change_me_generate_a_random_secret
